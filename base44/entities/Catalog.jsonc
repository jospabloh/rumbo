{
  "name": "Catalog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "category": {
      "type": "string",
      "title": "Categoría"
    },
    "label": {
      "type": "string",
      "title": "Etiqueta"
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Orden",
      "default": 0
    }
  },
  "required": [
    "category",
    "label"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "owner",
            "admin"
          ]
        }
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "owner",
            "admin"
          ]
        }
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "owner",
            "admin"
          ]
        }
      }
    }
  }
}
