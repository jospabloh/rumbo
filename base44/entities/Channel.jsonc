{
  "name": "Channel",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "kind": {
      "type": "string",
      "enum": [
        "broadcast",
        "direct"
      ],
      "title": "Tipo",
      "default": "direct"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor (para canales directos)"
    }
  },
  "required": [
    "kind"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.kind": "broadcast"
        },
        {
          "data.driver_id": "{{user.data.driver_profile_id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    }
  }
}