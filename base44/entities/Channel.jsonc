{
  "name": "Channel",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "kind": {
      "type": "string",
      "enum": [
        "broadcast",
        "direct"
      ],
      "title": "Tipo",
      "default": "direct"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor (para canales directos)"
    }
  },
  "required": [
    "kind"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "owner",
            "admin",
            "dispatcher"
          ]
        }
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": {
              "$in": [
                "owner",
                "admin",
                "dispatcher"
              ]
            }
          }
        },
        {
          "data.kind": "broadcast"
        },
        {
          "data.driver_id": "{{user.data.driver_profile_id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "owner",
            "admin",
            "dispatcher"
          ]
        }
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "user_condition": {
        "role": {
          "$in": [
            "owner",
            "admin"
          ]
        }
      }
    }
  }
}