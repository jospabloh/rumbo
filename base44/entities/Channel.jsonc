{
  "name": "Channel",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "kind": {
      "type": "string",
      "enum": [
        "broadcast",
        "direct"
      ],
      "title": "Tipo",
      "default": "direct"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor (para canales directos)"
    }
  },
  "required": [
    "kind"
  ]
}