{
  "name": "Driver",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "full_name": {
      "type": "string",
      "title": "Nombre completo"
    },
    "license_no": {
      "type": "string",
      "title": "No. de licencia"
    },
    "license_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento de licencia"
    },
    "background_check_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de antecedentes"
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "title": "Calificaci\u00f3n"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "title": "Estado",
      "default": "active"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de contrataci\u00f3n"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto"
    },
    "license_file_url": {
      "type": "string",
      "title": "Archivo de licencia"
    },
    "ine_file_url": {
      "type": "string",
      "title": "Archivo de INE"
    },
    "address_proof_file_url": {
      "type": "string",
      "title": "Comprobante de domicilio"
    },
    "referred_by_driver_id": {
      "type": "string",
      "title": "Referido por (conductor)"
    },
    "referral_bonus_paid": {
      "type": "boolean",
      "title": "Bono de referido aplicado",
      "default": false
    },
    "profile_id": {
      "type": "string",
      "title": "ID de perfil vinculado"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.profile_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.profile_id": "{{user.id}}"
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    }
  }
}
