        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "Foto",
      "type": "string"
    },
    "profile_id": {
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "ID de perfil vinculado",
      "type": "string"
    },
    "rating": {
      "maximum": 5,
      "minimum": 0,
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "Calificaci\u00f3n",
      "type": "number"
    },
    "referral_bonus_paid": {
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "Bono de referido aplicado",
      "type": "boolean"
    },
    "referral_credit": {
      "default": 0,
      "description": "Sobrante del bono de referido que no cupo en los cobros abiertos; se descuenta autom\u00e1ticamente de los pr\u00f3ximos cobros generados para este conductor.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "Cr\u00e9dito de bono por aplicar",
      "type": "number"
    },
    "referred_by_driver_id": {
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "Referido por (conductor)",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "Estado",
      "type": "string"
    },
    "tenant_id": {
      "description": "Tenant al que pertenece este registro. Server-authoritative en la pr\u00e1ctica: guardedEntityWrite lo fija tras esparcir los datos del cliente (nunca antes, as\u00ed que un valor enviado por el cliente no puede ganar), y en update lo borra del patch para que un registro existente no pueda reasignarse a otro tenant. write:false es la frontera dura que respalda esa garant\u00eda incluso si alguien llama a la entidad directo por SDK, salt\u00e1ndose guardedEntityWrite.",
      "rls": {
        "write": false
      },
      "title": "Tenant",
      "type": "string"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.profile_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "dispatcher"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.profile_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "data.write_access": "enabled"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "dispatcher"
                  }
                }
              ]
            },
            {
              "user_condition": {
                "data.write_access": "enabled"
              }
            }
          ]
        }
      ]
    }
  },
  "type": "object"
}