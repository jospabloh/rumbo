{
  "name": "Driver",
  "properties": {
    "address_proof_file_url": {
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      },
      "title": "Comprobante de domicilio",
      "type": "string"
    },
    "aval_name": {
