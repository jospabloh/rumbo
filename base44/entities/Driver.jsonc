{
  "name": "Driver",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "full_name": {
      "type": "string",
      "title": "Nombre completo",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "license_no": {
      "type": "string",
      "title": "No. de licencia",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "license_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento de licencia",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "background_check_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de antecedentes",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "rating": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "title": "Calificación",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive"
      ],
      "title": "Estado",
      "default": "active",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de contratación",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "phone": {
      "type": "string",
      "title": "Teléfono"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "license_file_url": {
      "type": "string",
      "title": "Archivo de licencia",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "ine_file_url": {
      "type": "string",
      "title": "Archivo de INE",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "address_proof_file_url": {
      "type": "string",
      "title": "Comprobante de domicilio",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "referred_by_driver_id": {
      "type": "string",
      "title": "Referido por (conductor)",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "referral_bonus_paid": {
      "type": "boolean",
      "title": "Bono de referido aplicado",
      "default": false,
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "referral_credit": {
      "type": "number",
      "title": "Crédito de bono por aplicar",
      "default": 0,
      "description": "Sobrante del bono de referido que no cupo en los cobros abiertos; se descuenta automáticamente de los próximos cobros generados para este conductor.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "profile_id": {
      "type": "string",
      "title": "ID de perfil vinculado",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    },
    "aval_name": {
      "type": "string",
      "title": "Nombre del aval",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.profile_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.profile_id": "{{user.id}}"
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    }
  }
}
