{
  // Owner/admin only — a note is deliberately "private" (HR-sensitive content
  // about a driver, kept out of the dispatcher's operational view). The UI
  // (src/components/drivers/DriverDetail.jsx) has always labeled this section
  // "solo admin" and docs/permissions_matrix.md has always documented it as
  // owner/admin only; RLS previously also granted the dispatcher role create/
  // read/update access here, contradicting both. Fixed (audit/rumbo-full-review)
  // to match the documented/labeled intent — delete was already owner/admin only.
  "name": "DriverPrivateNote",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant",
      "rls": { "write": false }
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor"
    },
    "author_id": {
      "type": "string",
      "title": "Autor"
    },
    "note": {
      "type": "string",
      "title": "Nota"
    }
  },
  "required": [
    "driver_id",
    "note"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}