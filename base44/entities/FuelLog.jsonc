{
  "name": "FuelLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Veh\u00edculo"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor"
    },
    "liters": {
      "type": "number",
      "title": "Litros"
    },
    "price_per_liter": {
      "type": "number",
      "title": "Precio por litro"
    },
    "total_cost": {
      "type": "number",
      "title": "Costo total"
    },
    "odometer": {
      "type": "number",
      "title": "Od\u00f3metro (km)"
    },
    "receipt_photo_url": {
      "type": "string",
      "title": "Foto de recibo"
    },
    "logged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha y hora"
    }
  },
  "required": [
    "vehicle_id",
    "driver_id",
    "liters",
    "total_cost"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.driver_id": "{{user.data.driver_profile_id}}"
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.driver_id": "{{user.data.driver_profile_id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    }
  }
}
