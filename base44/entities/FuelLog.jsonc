{
  "name": "FuelLog",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant",
      "rls": {
        "write": false
      },
      "description": "Tenant al que pertenece este registro. Server-authoritative en la práctica: guardedEntityWrite lo fija tras esparcir los datos del cliente (nunca antes, así que un valor enviado por el cliente no puede ganar), y en update lo borra del patch para que un registro existente no pueda reasignarse a otro tenant. write:false es la frontera dura que respalda esa garantía incluso si alguien llama a la entidad directo por SDK, saltándose guardedEntityWrite."
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehículo"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor"
    },
    "liters": {
      "type": "number",
      "title": "Litros"
    },
    "price_per_liter": {
      "type": "number",
      "title": "Precio por litro"
    },
    "total_cost": {
      "type": "number",
      "title": "Costo total"
    },
    "odometer": {
      "type": "number",
      "title": "Odómetro (km)"
    },
    "receipt_photo_url": {
      "type": "string",
      "title": "Foto de recibo"
    },
    "logged_at": {
      "type": "string",
      "format": "date-time",
      "title": "Fecha y hora"
    }
  },
  "required": [
    "vehicle_id",
    "driver_id",
    "liters",
    "total_cost"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "data.driver_id": "{{user.data.driver_profile_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "data.driver_id": "{{user.data.driver_profile_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}
