{
  "name": "InsuranceClaim",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Veh\u00edculo"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "claim_amount": {
      "type": "number",
      "title": "Monto del reclamo"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "approved",
        "denied",
        "closed"
      ],
      "title": "Estado",
      "default": "open"
    },
    "incident_at": {
      "type": "string",
      "format": "date",
      "title": "Fecha del incidente"
    }
  },
  "required": [
    "vehicle_id",
    "driver_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.driver_id": "{{user.data.driver_profile_id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "data.write_access": "enabled"
      }
    }
  }
}
