{
  "name": "LocationRequest",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Veh\u00edculo"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor"
    },
    "requested_by": {
      "type": "string",
      "title": "Solicitado por"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "fulfilled",
        "expired"
      ],
      "title": "Estado",
      "default": "pending"
    },
    "lat": {
      "type": "number",
      "title": "Latitud"
    },
    "lng": {
      "type": "number",
      "title": "Longitud"
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "title": "Solicitado en"
    },
    "responded_at": {
      "type": "string",
      "format": "date-time",
      "title": "Respondido en"
    }
  },
  "required": [
    "vehicle_id",
    "driver_id",
    "requested_by"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "data.driver_id": "{{user.data.driver_profile_id}}"
            },
            {
              "data.requested_by": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "$and": [
                {
                  "data.driver_id": "{{user.data.driver_profile_id}}"
                },
                {
                  "data.status": "pending"
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}