{
  "name": "Maintenance",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant",
      "rls": {
        "write": false
      },
      "description": "Tenant al que pertenece este registro. Server-authoritative en la práctica: guardedEntityWrite lo fija tras esparcir los datos del cliente (nunca antes, así que un valor enviado por el cliente no puede ganar), y en update lo borra del patch para que un registro existente no pueda reasignarse a otro tenant. write:false es la frontera dura que respalda esa garantía incluso si alguien llama a la entidad directo por SDK, saltándose guardedEntityWrite."
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehículo"
    },
    "kind": {
      "type": "string",
      "enum": [
        "preventive",
        "corrective",
        "major_repair"
      ],
      "title": "Tipo",
      "default": "preventive"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "engine",
        "brakes",
        "electrical",
        "tires",
        "body",
        "other"
      ],
      "title": "Categoría",
      "default": "general"
    },
    "description": {
      "type": "string",
      "title": "Descripción"
    },
    "odometer": {
      "type": "number",
      "title": "Odómetro (km)"
    },
    "cost": {
      "type": "number",
      "title": "Costo"
    },
    "performed_at": {
      "type": "string",
      "format": "date",
      "title": "Fecha de realización"
    },
    "next_due_at": {
      "type": "string",
      "format": "date",
      "title": "Próxima revisión"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto"
    },
    "owner_group_id": {
      "type": "string",
      "title": "Grupo de sociedad",
      "description": "Copia de `Vehicle.owner_group_id` en el momento de creación de este registro (denormalizado, igual que `driver_id` en RentCharge), para que un usuario 'investor' pueda leer el historial de mantenimiento de sus unidades sin depender de un join cruzado que RLS no soporta."
    }
  },
  "required": [
    "vehicle_id",
    "kind"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "investor"
                  }
                },
                {
                  "data.owner_group_id": {
                    "$ne": null
                  }
                },
                {
                  "data.owner_group_id": "{{user.data.owner_group_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}
