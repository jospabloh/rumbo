{
  "name": "Maintenance",
  "properties": {
    "category": {
      "default": "general",
      "enum": [
        "general",
        "oil_change",
        "engine",
        "brakes",
        "electrical",
        "tires",
        "body",
        "other"
      ],
      "title": "Categor\u00eda",
      "type": "string"
    },
    "cost": {
      "title": "Costo",
      "type": "number"
    },
    "description": {
      "title": "Descripci\u00f3n",
      "type": "string"
    },
    "kind": {
      "default": "preventive",
      "enum": [
        "preventive",
        "corrective",
        "major_repair"
      ],
      "title": "Tipo",
      "type": "string"
    },
    "next_due_at": {
      "format": "date",
      "title": "Pr\u00f3xima revisi\u00f3n",
      "type": "string"
    },
    "odometer": {
      "title": "Od\u00f3metro (km)",
      "type": "number"
    },
    "owner_group_id": {
      "description": "Copia de `Vehicle.owner_group_id` en el momento de creaci\u00f3n de este registro (denormalizado, igual que `driver_id` en RentCharge), para que un usuario 'investor' pueda leer el historial de mantenimiento de sus unidades sin depender de un join cruzado que RLS no soporta.",
      "title": "Grupo de sociedad",
      "type": "string"
    },
    "performed_at": {
      "format": "date",
      "title": "Fecha de realizaci\u00f3n",
      "type": "string"
    },
    "photo_url": {
      "title": "Foto",
      "type": "string"
    },
    "tenant_id": {
      "description": "Tenant al que pertenece este registro. Server-authoritative en la pr\u00e1ctica: guardedEntityWrite lo fija tras esparcir los datos del cliente (nunca antes, as\u00ed que un valor enviado por el cliente no puede ganar), y en update lo borra del patch para que un registro existente no pueda reasignarse a otro tenant. write:false es la frontera dura que respalda esa garant\u00eda incluso si alguien llama a la entidad directo por SDK, salt\u00e1ndose guardedEntityWrite.",
      "rls": {
        "write": false
      },
      "title": "Tenant",
      "type": "string"
    },
    "vehicle_id": {
      "title": "Veh\u00edculo",
      "type": "string"
    }
  },
  "required": [
    "vehicle_id",
    "kind"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "investor"
                  }
                },
                {
                  "data.owner_group_id": {
                    "$ne": null
                  }
                },
                {
                  "data.owner_group_id": "{{user.data.owner_group_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  },
  "type": "object"
}