{
  "name": "Maintenance",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Veh\u00edculo"
    },
    "kind": {
      "type": "string",
      "enum": [
        "preventive",
        "corrective"
      ],
      "title": "Tipo",
      "default": "preventive"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "odometer": {
      "type": "number",
      "title": "Od\u00f3metro (km)"
    },
    "cost": {
      "type": "number",
      "title": "Costo"
    },
    "performed_at": {
      "type": "string",
      "format": "date",
      "title": "Fecha de realizaci\u00f3n"
    },
    "next_due_at": {
      "type": "string",
      "format": "date",
      "title": "Pr\u00f3xima revisi\u00f3n"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto"
    }
  },
  "required": [
    "vehicle_id",
    "kind"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
