{
  "name": "Message",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "channel_id": {
      "type": "string",
      "title": "Canal"
    },
    "sender_id": {
      "type": "string",
      "title": "Remitente (user id)"
    },
    "sender_name": {
      "type": "string",
      "title": "Nombre del remitente"
    },
    "body": {
      "type": "string",
      "title": "Mensaje"
    },
    "audio_url": {
      "type": "string",
      "title": "URL de audio"
    },
    "delivered": {
      "type": "boolean",
      "title": "Entregado",
      "default": false
    },
    "read": {
      "type": "boolean",
      "title": "Le\u00eddo",
      "default": false
    }
  },
  "required": [
    "channel_id",
    "sender_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "data.sender_id": "{{user.id}}"
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.sender_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
