{
  "name": "Message",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "channel_id": {
      "type": "string",
      "title": "Canal"
    },
    "channel_kind": {
      "type": "string",
      "enum": [
        "broadcast",
        "direct"
      ],
      "title": "Tipo de canal (denormalizado)",
      "description": "Copia de Channel.kind al crear el mensaje. Permite que la RLS de lectura deje leer los mensajes de un canal broadcast a todo el tenant sin tener que consultar la entidad Channel (las RLS de Base44 no hacen joins)."
    },
    "channel_driver_id": {
      "type": "string",
      "title": "Conductor del canal (denormalizado)",
      "description": "Copia de Channel.driver_id al crear el mensaje. Permite que la RLS de lectura deje a un conductor leer los mensajes de su propio canal directo (channel_driver_id == driver_profile_id), no solo los que él mismo envió."
    },
    "sender_id": {
      "type": "string",
      "title": "Remitente (user id)"
    },
    "sender_name": {
      "type": "string",
      "title": "Nombre del remitente"
    },
    "body": {
      "type": "string",
      "title": "Mensaje"
    },
    "audio_url": {
      "type": "string",
      "title": "URL de audio"
    },
    "delivered": {
      "type": "boolean",
      "title": "Entregado",
      "default": false
    },
    "read": {
      "type": "boolean",
      "title": "Leído",
      "default": false
    }
  },
  "required": [
    "channel_id",
    "sender_id"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "data.sender_id": "{{user.id}}",
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.channel_kind": "broadcast"
        },
        {
          "data.channel_driver_id": "{{user.data.driver_profile_id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    }
  }
}
