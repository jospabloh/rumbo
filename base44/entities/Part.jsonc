{
  "name": "Part",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "brand": {
      "type": "string",
      "title": "Marca"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "unit_number": {
      "type": "string",
      "title": "No. de unidad"
    },
    "stock": {
      "type": "number",
      "title": "Stock",
      "minimum": 0,
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "title": "Costo unitario"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Veh\u00edculo asociado"
    },
    "maintenance_id": {
      "type": "string",
      "title": "Mantenimiento asociado"
    }
  },
  "required": [
    "name",
    "stock"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    }
  }
}
