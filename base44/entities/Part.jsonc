{
  "name": "Part",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant",
      "rls": {
        "write": false
      },
      "description": "Tenant al que pertenece este registro. Server-authoritative en la práctica: guardedEntityWrite lo fija tras esparcir los datos del cliente (nunca antes, así que un valor enviado por el cliente no puede ganar), y en update lo borra del patch para que un registro existente no pueda reasignarse a otro tenant. write:false es la frontera dura que respalda esa garantía incluso si alguien llama a la entidad directo por SDK, saltándose guardedEntityWrite."
    },
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "brand": {
      "type": "string",
      "title": "Marca"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "unit_number": {
      "type": "string",
      "title": "No. de unidad"
    },
    "stock": {
      "type": "number",
      "title": "Stock",
      "minimum": 0,
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "title": "Stock mínimo",
      "minimum": 0,
      "default": 0
    },
    "unit_cost": {
      "type": "number",
      "title": "Costo unitario"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Vehículo asociado"
    },
    "maintenance_id": {
      "type": "string",
      "title": "Mantenimiento asociado"
    }
  },
  "required": [
    "name",
    "stock"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}
