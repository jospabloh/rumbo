{
  "name": "RentCharge",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "vehicle_id": {
      "type": "string",
      "title": "Veh\u00edculo"
    },
    "driver_id": {
      "type": "string",
      "title": "Conductor"
    },
    "period_type": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "title": "Frecuencia",
      "default": "weekly"
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "title": "Inicio del periodo"
    },
    "period_end": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo"
    },
    "amount_due": {
      "type": "number",
      "title": "Monto de la renta"
    },
    "amount_paid": {
      "type": "number",
      "title": "Monto pagado",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "paid"
      ],
      "title": "Estado",
      "default": "pending"
    },
    "payments": {
      "type": "array",
      "title": "Pagos recibidos",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "title": "Monto"
          },
          "paid_at": {
            "type": "string",
            "format": "date",
            "title": "Fecha de pago"
          },
          "method": {
            "type": "string",
            "title": "M\u00e9todo"
          },
          "note": {
            "type": "string",
            "title": "Nota"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "carried_over_amount": {
      "type": "number",
      "title": "Saldo trasladado de la semana anterior",
      "default": 0
    },
    "carried_forward": {
      "type": "boolean",
      "title": "Saldo trasladado a la siguiente semana",
      "default": false
    },
    "owner_group_id": {
      "type": "string",
      "title": "Grupo de sociedad",
      "description": "Copia de `Vehicle.owner_group_id` en el momento de creación de este cobro (denormalizado, igual que `driver_id`), para que un usuario 'investor' pueda ver si el chofer está pagando la renta de sus unidades sin depender de un join cruzado que RLS no soporta."
    }
  },
  "required": [
    "vehicle_id",
    "period_start",
    "amount_due"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "data.driver_id": "{{user.data.driver_profile_id}}"
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "investor"
                  }
                },
                {
                  "data.owner_group_id": {
                    "$ne": null
                  }
                },
                {
                  "data.owner_group_id": "{{user.data.owner_group_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}