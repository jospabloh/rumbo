{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "title": "Folio",
      "description": "Folio legible del ticket (ITSM), p. ej. RUM-000001. Lo asigna submitTicket del lado servidor; el cliente no lo escribe."
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "tenant_name": {
      "type": "string",
      "title": "Organización"
    },
    "subject": {
      "type": "string",
      "title": "Asunto"
    },
    "body": {
      "type": "string",
      "title": "Descripción"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "question",
        "billing",
        "feature",
        "other"
      ],
      "default": "question",
      "title": "Categoría"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal",
      "title": "Prioridad"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "title": "Estatus"
    },
    "requester_id": {
      "type": "string",
      "title": "Solicitante (ID)"
    },
    "requester_name": {
      "type": "string",
      "title": "Solicitante"
    },
    "requester_email": {
      "type": "string",
      "title": "Correo del solicitante"
    },
    "responses": {
      "type": "array",
      "title": "Respuestas",
      "items": {
        "type": "object",
        "properties": {
          "author_name": { "type": "string" },
          "author_role": { "type": "string" },
          "body": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "default": []
    },
    "last_activity_at": {
      "type": "string",
      "title": "Última actividad"
    },
    "ai_brief": {
      "type": "object",
      "title": "Brief BA/PO (IA)",
      "description": "Especificación estructurada que arma el asistente BA/PO al levantar un feature o incidencia (historia de usuario, criterios de aceptación, pasos de reproducción, impacto, etc.). El mismo brief se incrusta en 'body' en Markdown, así que este campo es aditivo para el render enriquecido en Mission Control."
    }
  },
  "required": [
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "user_condition": { "role": "owner" }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "user_condition": { "role": "admin" }
        },
        {
          "data.requester_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        { "user_condition": { "role": "owner" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": { "role": "owner" }
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    }
  }
}
