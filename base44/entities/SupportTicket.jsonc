{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "title": "Folio",
      "description": "Folio legible del ticket (ITSM), p. ej. RUM-000001. Lo asigna submitTicket del lado servidor; el cliente no lo escribe.",
      "rls": {
        "write": false
      }
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant",
      "rls": {
        "write": false
      },
      "description": "Tenant al que pertenece este ticket. Lo fija submitTicket del lado servidor al crear el registro, nunca el cliente. write:false evita que un ticket se reasigne a otro tenant después, y evita que un remitente declare pertenecer a un tenant ajeno al enviarlo."
    },
    "tenant_name": {
      "type": "string",
      "title": "Organización",
      "rls": {
        "write": false
      },
      "description": "Nombre del tenant en el momento de crear el ticket (copia de despliegue, no una referencia viva al TenantLicense actual) — lo fija submitTicket del lado servidor. write:false evita que el remitente falsifique de qué organización dice venir el ticket."
    },
    "subject": {
      "type": "string",
      "title": "Asunto"
    },
    "body": {
      "type": "string",
      "title": "Descripción"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "question",
        "billing",
        "feature",
        "other"
      ],
      "default": "question",
      "title": "Categoría"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal",
      "title": "Prioridad"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "title": "Estatus"
    },
    "requester_id": {
      "type": "string",
      "title": "Solicitante (ID)",
      "rls": {
        "write": false
      },
      "description": "Id del usuario que envió el ticket. Lo fija submitTicket con el id de la sesión autenticada (`user.id`), nunca del cuerpo de la petición — write:false evita que un ticket se atribuya a otro usuario, cosa que también gobierna la regla `read` de esta entidad (`data.requester_id == {{user.id}}` es una de las formas en que alguien puede leer su propio ticket)."
    },
    "requester_name": {
      "type": "string",
      "title": "Solicitante"
    },
    "requester_email": {
      "type": "string",
      "title": "Correo del solicitante",
      "rls": {
        "write": false
      },
      "description": "Correo del usuario que envió el ticket, tomado de su sesión autenticada por submitTicket. write:false evita que el remitente declare un correo ajeno — importa porque es la dirección a la que se responde."
    },
    "responses": {
      "type": "array",
      "title": "Respuestas",
      "items": {
        "type": "object",
        "properties": {
          "author_name": {
            "type": "string"
          },
          "author_role": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "last_activity_at": {
      "type": "string",
      "title": "Última actividad"
    },
    "ai_brief": {
      "type": "object",
      "title": "Brief BA/PO (IA)",
      "description": "Especificación estructurada que arma el asistente BA/PO al levantar un feature o incidencia (historia de usuario, criterios de aceptación, pasos de reproducción, impacto, etc.). El mismo brief se incrusta en 'body' en Markdown, así que este campo es aditivo para el render enriquecido en Mission Control."
    }
  },
  "required": [
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.requester_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
