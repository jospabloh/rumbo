{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticket_number": {
      "type": "string",
      "title": "Folio",
      "description": "Folio legible del ticket (ITSM), p. ej. RUM-000001. Lo asigna submitTicket del lado servidor; el cliente no lo escribe.",
      "rls": {
        "write": false
      }
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "tenant_name": {
      "type": "string",
      "title": "Organizaci\u00f3n",
      "rls": {
        "write": false
      }
    },
    "subject": {
      "type": "string",
      "title": "Asunto"
    },
    "body": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "question",
        "billing",
        "feature",
        "other"
      ],
      "default": "question",
      "title": "Categor\u00eda"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal",
      "title": "Prioridad"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "title": "Estatus"
    },
    "requester_id": {
      "type": "string",
      "title": "Solicitante (ID)",
      "rls": {
        "write": false
      }
    },
    "requester_name": {
      "type": "string",
      "title": "Solicitante"
    },
    "requester_email": {
      "type": "string",
      "title": "Correo del solicitante",
      "rls": {
        "write": false
      }
    },
    "responses": {
      "type": "array",
      "title": "Respuestas",
      "items": {
        "type": "object",
        "properties": {
          "author_name": {
            "type": "string"
          },
          "author_role": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "last_activity_at": {
      "type": "string",
      "title": "\u00daltima actividad"
    },
    "ai_brief": {
      "type": "object",
      "title": "Brief BA/PO (IA)",
      "description": "Especificaci\u00f3n estructurada que arma el asistente BA/PO al levantar un feature o incidencia (historia de usuario, criterios de aceptaci\u00f3n, pasos de reproducci\u00f3n, impacto, etc.). El mismo brief se incrusta en 'body' en Markdown, as\u00ed que este campo es aditivo para el render enriquecido en Mission Control."
    }
  },
  "required": [
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}"
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "owner"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "data.requester_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}