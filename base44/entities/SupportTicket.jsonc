{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "tenant_name": {
      "type": "string",
      "title": "Organización"
    },
    "subject": {
      "type": "string",
      "title": "Asunto"
    },
    "body": {
      "type": "string",
      "title": "Descripción"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "question",
        "billing",
        "feature",
        "other"
      ],
      "default": "question",
      "title": "Categoría"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ],
      "default": "normal",
      "title": "Prioridad"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "title": "Estatus"
    },
    "requester_id": {
      "type": "string",
      "title": "Solicitante (ID)"
    },
    "requester_name": {
      "type": "string",
      "title": "Solicitante"
    },
    "requester_email": {
      "type": "string",
      "title": "Correo del solicitante"
    },
    "responses": {
      "type": "array",
      "title": "Respuestas",
      "items": {
        "type": "object",
        "properties": {
          "author_name": { "type": "string" },
          "author_role": { "type": "string" },
          "body": { "type": "string" },
          "created_at": { "type": "string" }
        }
      },
      "default": []
    },
    "last_activity_at": {
      "type": "string",
      "title": "Última actividad"
    }
  },
  "required": [
    "subject",
    "body"
  ],
  "rls": {
    "create": {
      "$or": [
        { "data.tenant_id": "{{user.data.tenant_id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "user_condition": { "role": "owner" }
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "user_condition": { "role": "admin" }
        },
        {
          "data.requester_id": "{{user.id}}"
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}",
          "$or": [
            { "user_condition": { "role": "owner" } },
            { "user_condition": { "role": "admin" } }
          ]
        },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": { "role": "owner" }
        },
        {
          "user_condition": { "role": "admin" }
        }
      ]
    }
  }
}
