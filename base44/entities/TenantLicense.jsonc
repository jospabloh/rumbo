{
  "name": "TenantLicense",
  "type": "object",
  "properties": {
    "tenant_name": {
      "type": "string",
      "title": "Nombre del tenant"
    },
    "slogan": {
      "type": "string",
      "title": "Slogan"
    },
    "logo_url": {
      "type": "string",
      "title": "URL del logo"
    },
    "color_primary": {
      "type": "string",
      "title": "Color primario (hex)"
    },
    "color_secondary": {
      "type": "string",
      "title": "Color secundario (hex)"
    },
    "color_accent": {
      "type": "string",
      "title": "Color acento (hex)"
    },
    "color_background": {
      "type": "string",
      "title": "Color de fondo (hex)"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "pro",
        "enterprise"
      ],
      "title": "Plan",
      "default": "trial",
      // Fixed 2026-08-19 (re-verification audit, module 1): server-authoritative —
      // only asServiceRole (createTenant on signup, licensesAdmin's `renew`/`patch`
      // actions, acaciaControl's `license.set` from Mission Control) may write this.
      // Before this fix the entity-level update rule let a tenant's own owner/admin
      // write ANY field including this one — self-upgrading their own plan via a
      // direct SDK call, or via SuperAdminPanel.jsx (now migrated to licensesAdmin).
      "rls": { "write": false }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "suspended",
        "cancelled",
        "view_only"
      ],
      "title": "Estado",
      "default": "active",
      // view_only agregado 2026-08-03: cierra el hueco de solo-lectura (día 8
      // del ciclo unificado de licencias) que Rumbo no tenía — ver
      // docs/superpowers/specs/2026-08-03-portfolio-license-lifecycle-design.md
      // en acacia-mission-control. Committear este .jsonc NO cambia el
      // schema desplegado en Base44 — falta el deploy real (Base44 MCP) y
      // luego flippear `readOnlyStatus: null` -> `'view_only'` en
      // acacia-mission-control/api/_lib/licenseControl.js para rumbo.
      //
      // Fixed 2026-08-19 (re-verification audit, module 1): server-authoritative,
      // same reasoning as `plan` above — a suspended/view_only tenant's own owner
      // could otherwise flip themselves back to `active` directly.
      "rls": { "write": false }
    },
    "max_vehicles": {
      "type": "number",
      "title": "Vehículos máximos",
      "default": 5,
      // Fixed 2026-08-19 (re-verification audit, module 1): server-authoritative,
      // same reasoning as `plan` — this is a plan-tier limit, not tenant config.
      "rls": { "write": false }
    },
    "max_drivers": {
      "type": "number",
      "title": "Conductores máximos",
      "default": 5,
      "rls": { "write": false }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Funcionalidades habilitadas",
      "rls": { "write": false }
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo de prueba",
      "rls": { "write": false }
    },
    "current_period_end": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo pagado",
      "rls": { "write": false }
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "title": "Ciclo de cobro",
      "default": "monthly",
      "rls": { "write": false }
    },
    "last_payment_at": {
      "type": "string",
      "format": "date",
      "title": "Último pago confirmado",
      "rls": { "write": false }
    },
    "renews_at": {
      "type": "string",
      "format": "date",
      "title": "Fecha de renovación",
      "rls": { "write": false }
    },
    "owner_email": {
      "type": "string",
      "title": "Email del owner",
      // Fixed 2026-08-24 (module 14 finding, 2026-08-23): TenantLicense.delete keys on
      // nothing but `data.owner_email == {{user.email}}`, and update was open to any
      // same-tenant owner OR admin — so an admin could self-delegate ownership from
      // DangerZone.jsx and immediately satisfy delete. Field-level write:false here closes
      // that (same mechanism as the 10 license fields above); the only remaining writers
      // are asServiceRole callers: `delegateOwnership` (re-checks the caller IS the
      // *stored* owner before reassigning — tenant self-service) and `licensesAdmin`'s
      // `patch` action (APP_OWNER_EMAIL-gated platform override).
      "rls": { "write": false }
    },
    "join_code": {
      "type": "string",
      "title": "Código de unión del tenant"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "permissions_config": {
      "type": "object",
      "title": "Configuración de permisos por rol"
    },
    "settings": {
      "type": "object",
      "title": "Configuración de negocio del tenant (bono de referido, ventana de costo/km, etc.). Editable por owner/admin del tenant y por el platform owner vía licensesAdmin. Cada ajuste tiene un default en la app si no se personaliza."
    },
    "members": {
      "type": "array",
      "title": "Miembros del tenant",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Rol"
          }
        }
      }
    }
  },
  "required": [
    "plan",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.members.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "id": "{{user.data.tenant_id}}"
            },
            {
              "data.members.email": "{{user.email}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}
