{
  "name": "TenantLicense",
  "type": "object",
  "properties": {
    "tenant_name": {
      "type": "string",
      "title": "Nombre del tenant"
    },
    "slogan": {
      "type": "string",
      "title": "Slogan"
    },
    "logo_url": {
      "type": "string",
      "title": "URL del logo"
    },
    "color_primary": {
      "type": "string",
      "title": "Color primario (hex)"
    },
    "color_secondary": {
      "type": "string",
      "title": "Color secundario (hex)"
    },
    "color_accent": {
      "type": "string",
      "title": "Color acento (hex)"
    },
    "color_background": {
      "type": "string",
      "title": "Color de fondo (hex)"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "pro",
        "enterprise"
      ],
      "title": "Plan",
      "default": "trial"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "suspended",
        "cancelled"
      ],
      "title": "Estado",
      "default": "active"
    },
    "max_vehicles": {
      "type": "number",
      "title": "Veh\u00edculos m\u00e1ximos",
      "default": 5
    },
    "max_drivers": {
      "type": "number",
      "title": "Conductores m\u00e1ximos",
      "default": 5
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Funcionalidades habilitadas"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo de prueba"
    },
    "renews_at": {
      "type": "string",
      "format": "date",
      "title": "Fecha de renovaci\u00f3n"
    },
    "owner_email": {
      "type": "string",
      "title": "Email del owner"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "permissions_config": {
      "type": "string",
      "title": "Configuración de permisos por rol (JSON)"
    },
    "members": {
      "type": "array",
      "title": "Miembros del tenant",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Rol"
          }
        }
      }
    }
  },
  "required": [
    "plan",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "owner"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "owner",
                "admin"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    }
  }
}