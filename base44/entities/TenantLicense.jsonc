{
  "name": "TenantLicense",
  "type": "object",
  "properties": {
    "tenant_name": {
      "type": "string",
      "title": "Nombre del tenant"
    },
    "slogan": {
      "type": "string",
      "title": "Slogan"
    },
    "logo_url": {
      "type": "string",
      "title": "URL del logo"
    },
    "color_primary": {
      "type": "string",
      "title": "Color primario (hex)"
    },
    "color_secondary": {
      "type": "string",
      "title": "Color secundario (hex)"
    },
    "color_accent": {
      "type": "string",
      "title": "Color acento (hex)"
    },
    "color_background": {
      "type": "string",
      "title": "Color de fondo (hex)"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "pro",
        "enterprise"
      ],
      "title": "Plan",
      "default": "trial",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "suspended",
        "cancelled",
        "view_only"
      ],
      "title": "Estado",
      "default": "active",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "max_vehicles": {
      "type": "number",
      "title": "Vehículos máximos",
      "default": 5,
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "max_drivers": {
      "type": "number",
      "title": "Conductores máximos",
      "default": 5,
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Funcionalidades habilitadas",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo de prueba",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "current_period_end": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo pagado",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "title": "Ciclo de cobro",
      "default": "monthly",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "last_payment_at": {
      "type": "string",
      "format": "date",
      "title": "Último pago confirmado",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "renews_at": {
      "type": "string",
      "format": "date",
      "title": "Fecha de renovación",
      "rls": {
        "write": false
      },
      "description": "Campo de licencia/facturación. Server-authoritative: el único escritor es licensesAdmin (acciones renew/set_status/patch), gateado a APP_OWNER_EMAIL — es el dominio de Mission Control, no algo que el propio owner/admin del tenant deba poder tocar. write:false cierra el hallazgo del módulo 1 (2026-08-19): antes cualquier owner/admin del tenant podía escribir el registro entero directo por SDK, incluido revertir una licencia suspendida a activa o subirse el plan a mano."
    },
    "owner_email": {
      "type": "string",
      "title": "Email del owner",
      "rls": {
        "write": false
      },
      "description": "Email del owner del tenant. Server-authoritative: los únicos escritores son delegateOwnership (re-lee el owner_email ALMACENADO y exige que el caller ya lo sea) y licensesAdmin's patch (APP_OWNER_EMAIL, el owner de la plataforma). write:false cierra el hallazgo del módulo 14 (2026-08-24): antes cualquier admin del tenant podía delegarse la propiedad a sí mismo vía DangerZone.jsx y, con eso, satisfacer la única condición de TenantLicense.delete (`data.owner_email == {{user.email}}`)."
    },
    "join_code": {
      "type": "string",
      "title": "Código de unión del tenant"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "permissions_config": {
      "type": "object",
      "title": "Configuración de permisos por rol"
    },
    "settings": {
      "type": "object",
      "title": "Configuración de negocio del tenant (bono de referido, ventana de costo/km, etc.). Editable por owner/admin del tenant y por el platform owner vía licensesAdmin. Cada ajuste tiene un default en la app si no se personaliza."
    },
    "members": {
      "type": "array",
      "title": "Miembros del tenant",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Rol"
          }
        }
      }
    }
  },
  "required": [
    "plan",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "id": "{{user.data.tenant_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}
