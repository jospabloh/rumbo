{
  "name": "TenantLicense",
  "type": "object",
  "properties": {
    "tenant_name": {
      "type": "string",
      "title": "Nombre del tenant"
    },
    "slogan": {
      "type": "string",
      "title": "Slogan"
    },
    "logo_url": {
      "type": "string",
      "title": "URL del logo"
    },
    "color_primary": {
      "type": "string",
      "title": "Color primario (hex)"
    },
    "color_secondary": {
      "type": "string",
      "title": "Color secundario (hex)"
    },
    "color_accent": {
      "type": "string",
      "title": "Color acento (hex)"
    },
    "color_background": {
      "type": "string",
      "title": "Color de fondo (hex)"
    },
    "plan": {
      "type": "string",
      "enum": [
        "trial",
        "starter",
        "pro",
        "enterprise"
      ],
      "title": "Plan",
      "default": "trial"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "suspended",
        "cancelled"
      ],
      "title": "Estado",
      "default": "active"
    },
    "max_vehicles": {
      "type": "number",
      "title": "Veh\u00edculos m\u00e1ximos",
      "default": 5
    },
    "max_drivers": {
      "type": "number",
      "title": "Conductores m\u00e1ximos",
      "default": 5
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Funcionalidades habilitadas"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo de prueba"
    },
    "current_period_end": {
      "type": "string",
      "format": "date",
      "title": "Fin del periodo pagado"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "title": "Ciclo de cobro",
      "default": "monthly"
    },
    "last_payment_at": {
      "type": "string",
      "format": "date",
      "title": "\u00daltimo pago confirmado"
    },
    "renews_at": {
      "type": "string",
      "format": "date",
      "title": "Fecha de renovaci\u00f3n"
    },
    "owner_email": {
      "type": "string",
      "title": "Email del owner"
    },
    "join_code": {
      "type": "string",
      "title": "C\u00f3digo de uni\u00f3n del tenant"
    },
    "notes": {
      "type": "string",
      "title": "Notas"
    },
    "permissions_config": {
      "type": "object",
      "title": "Configuraci\u00f3n de permisos por rol"
    },
    "settings": {
      "type": "object",
      "title": "Configuraci\u00f3n de negocio del tenant (bono de referido, ventana de costo/km, etc.). Editable por owner/admin del tenant y por el platform owner v\u00eda licensesAdmin. Cada ajuste tiene un default en la app si no se personaliza."
    },
    "members": {
      "type": "array",
      "title": "Miembros del tenant",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "title": "Nombre"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Rol"
          }
        }
      }
    }
  },
  "required": [
    "plan",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.members.email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "data.owner_email": "{{user.email}}"
    }
  }
}