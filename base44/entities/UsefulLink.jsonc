{
  "name": "UsefulLink",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant",
      "rls": { "write": false }
    },
    "label": {
      "type": "string",
      "title": "Nombre"
    },
    "url": {
      "type": "string",
      "title": "URL"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "active": {
      "type": "boolean",
      "title": "Activo",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Orden",
      "default": 0
    }
  },
  "required": [
    "label",
    "url"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.active": true
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}