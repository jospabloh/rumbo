{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Rol del usuario en el sistema",
      "enum": [
        "owner",
        "admin",
        "dispatcher",
        "mechanic",
        "driver",
        "user"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": {
              "$in": [
                "owner",
                "admin"
              ]
            }
          }
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant del usuario. Server-authoritative: solo lo escribe resolveTenant con service role. Los clientes no pueden modificarlo (write: false), lo que evita que un usuario reapunte su perfil a otro tenant y lea datos ajenos vía RLS.",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin"
                  ]
                }
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "user_condition": {
                "role": {
                  "$in": [
                    "owner",
                    "admin"
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
