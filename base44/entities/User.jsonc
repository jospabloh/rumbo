{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "Rol del usuario en el sistema",
      "enum": [
        "owner",
        "admin",
        "dispatcher",
        "mechanic",
        "driver",
        "user"
      ]
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "owner"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "owner",
                "admin"
              ]
            }
          }
        }
      ]
    }
  }
}