{
  "name": "User",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string",
      "description": "Nombre para mostrar en la app, asignable por el admin del tenant. Si está vacío se usa el full_name de la cuenta. Editable por el propio usuario o por owner/admin de su tenant (RLS de entidad)."
    },
    "suspended": {
      "type": "boolean",
      "default": false,
      "description": "Acceso suspendido manualmente por un admin del tenant (independiente del estado de licencia). Server-authoritative: solo lo cambia la función manageMember con service role.",
      "rls": {
        "write": false
      }
    },
    "role": {
      "type": "string",
      "description": "Rol del usuario en el sistema. Server-authoritative: solo lo escribe manageRole con service role (además de resolveTenant/joinTenant/switchTenant en el primer enganche o cambio de tenant). write:false evita que un admin se auto-ascienda a owner o degrade al último admin del tenant sin control — antes de este candado (rls.write solo exigía \"el caller ya sea owner/admin\", sin volver a comprobar nada del lado del servidor) una llamada directa al SDK bastaba para ambas cosas.",
      "enum": [
        "owner",
        "admin",
        "dispatcher",
        "mechanic",
        "driver",
        "investor",
        "user"
      ],
      "rls": {
        "write": false
      }
    },
    "owner_group_id": {
      "type": "string",
      "title": "Grupo de sociedad",
      "description": "Etiqueta de sociedad/inversión asignada a un usuario 'investor'. Debe coincidir con el mismo campo en los `Vehicle` a los que debe tener acceso de solo lectura (estado, mantenimientos y rentas). Un tenant puede tener varios grupos (una sociedad por cada subconjunto de unidades). Solo lo asigna owner/admin, igual que `role`, para que un investor no pueda ampliar su propio alcance.",
      "rls": {
        "write": {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant del usuario. Server-authoritative: solo lo escribe resolveTenant con service role. Los clientes no pueden modificarlo (write: false), lo que evita que un usuario reapunte su perfil a otro tenant y lea datos ajenos v\u00eda RLS.",
      "rls": {
        "write": false
      }
    },
    "driver_profile_id": {
      "type": "string",
      "description": "Id del registro Driver vinculado a este usuario. Server-authoritative: solo lo setea resolveTenant con service role. write:false evita que un conductor lo falsifique para acceder a los datos de otro conductor.",
      "rls": {
        "write": false
      }
    },
    "write_access": {
      "type": "string",
      "enum": [
        "enabled",
        "blocked"
      ],
      "default": "enabled",
      "description": "Permiso de escritura segun el estado de la licencia del tenant. 'enabled' mientras la licencia esta active o past_due (gracia); 'blocked' cuando pasa a readonly (8+ dias vencido) o disabled (16+) / suspended / cancelled. Server-authoritative: solo lo setea resolveTenant con service role (write:false). Las RLS de create/update/delete de cada entidad operativa exigen user_condition write_access='enabled', por lo que un tenant vencido no puede escribir ni siquiera llamando al SDK directamente.",
      "rls": {
        "write": false
      }
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "data.tenant_id": "{{user.data.tenant_id}}"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "owner"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
