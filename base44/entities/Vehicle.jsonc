{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "plate": {
      "type": "string",
      "title": "Placa"
    },
    "unit_number": {
      "type": "string",
      "title": "No. de unidad"
    },
    "make": {
      "type": "string",
      "title": "Marca"
    },
    "model": {
      "type": "string",
      "title": "Modelo"
    },
    "year": {
      "type": "number",
      "title": "A\u00f1o"
    },
    "vin": {
      "type": "string",
      "title": "VIN"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "inactive"
      ],
      "title": "Estado",
      "default": "active"
    },
    "assigned_driver_id": {
      "type": "string",
      "title": "Conductor asignado"
    },
    "insurance_policy_no": {
      "type": "string",
      "title": "No. de p\u00f3liza"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento seguro"
    },
    "inspection_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento inspecci\u00f3n"
    },
    "registration_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento registro"
    },
    "hologram_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento holograma"
    },
    "odometer": {
      "type": "number",
      "title": "Od\u00f3metro (km)",
      "default": 0
    },
    "rent_amount": {
      "type": "number",
      "title": "Tarifa de renta"
    },
    "rent_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "title": "Frecuencia de renta",
      "default": "weekly"
    },
    "rent_day": {
      "type": "string",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "title": "D\u00eda de cobro (semanal)"
    },
    "insurance_company": {
      "type": "string",
      "title": "Aseguradora"
    },
    "insurance_annual_cost": {
      "type": "number",
      "title": "Costo anual de seguro"
    },
    "maintenance_reserve_weekly": {
      "type": "number",
      "title": "Reserva semanal para fondo de mantenimiento"
    },
    "owner_group_id": {
      "type": "string",
      "title": "Grupo de sociedad",
      "description": "Etiqueta de sociedad/inversión de esta unidad. Los usuarios con role='investor' y el mismo `owner_group_id` en su perfil ven esta unidad (y sus mantenimientos/rentas) en modo solo lectura."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            },
            {
              "data.assigned_driver_id": "{{user.data.driver_profile_id}}"
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "investor"
                  }
                },
                {
                  "data.owner_group_id": {
                    "$ne": null
                  }
                },
                {
                  "data.owner_group_id": "{{user.data.owner_group_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "user_condition": {
            "data.write_access": "enabled"
          }
        }
      ]
    }
  }
}