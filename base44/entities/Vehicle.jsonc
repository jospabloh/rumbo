{
  "name": "Vehicle",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant"
    },
    "plate": {
      "type": "string",
      "title": "Placa"
    },
    "unit_number": {
      "type": "string",
      "title": "No. de unidad"
    },
    "make": {
      "type": "string",
      "title": "Marca"
    },
    "model": {
      "type": "string",
      "title": "Modelo"
    },
    "year": {
      "type": "number",
      "title": "A\u00f1o"
    },
    "vin": {
      "type": "string",
      "title": "VIN"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "inactive"
      ],
      "title": "Estado",
      "default": "active"
    },
    "assigned_driver_id": {
      "type": "string",
      "title": "Conductor asignado"
    },
    "insurance_policy_no": {
      "type": "string",
      "title": "No. de p\u00f3liza"
    },
    "insurance_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento seguro"
    },
    "inspection_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento inspecci\u00f3n"
    },
    "registration_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento registro"
    },
    "hologram_expiry": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento holograma"
    },
    "odometer": {
      "type": "number",
      "title": "Od\u00f3metro (km)",
      "default": 0
    },
    "rent_amount": {
      "type": "number",
      "title": "Tarifa de renta"
    },
    "rent_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly"
      ],
      "title": "Frecuencia de renta",
      "default": "weekly"
    },
    "rent_day": {
      "type": "string",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "title": "D\u00eda de cobro (semanal)"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "owner"
              }
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "dispatcher"
              }
            },
            {
              "user_condition": {
                "role": "mechanic"
              }
            }
          ]
        },
        {
          "data.assigned_driver_id": "{{user.data.driver_profile_id}}"
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ],
      "user_condition": {
        "write_access": "enabled"
      }
    }
  }
}
