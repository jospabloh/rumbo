{
  "name": "VehicleDocument",
  "type": "object",
  "properties": {
    "vehicle_id": {
      "type": "string",
      "title": "Veh\u00edculo"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "insurance",
        "registration",
        "inspection",
        "title",
        "other"
      ],
      "title": "Tipo"
    },
    "file_url": {
      "type": "string",
      "title": "Archivo"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "title": "Vencimiento"
    }
  },
  "required": [
    "vehicle_id",
    "doc_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ]
    },
    "read": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        },
        {
          "user_condition": {
            "role": "mechanic"
          }
        }
      ]
    },
    "update": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "dispatcher"
          }
        }
      ]
    },
    "delete": {
      "data.tenant_id": "{{user.data.tenant_id}}",
      "$or": [
        {
          "user_condition": {
            "role": "owner"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
